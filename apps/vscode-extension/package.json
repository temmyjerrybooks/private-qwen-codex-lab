{
  "name": "borger-vscode-agent",
  "displayName": "Borger",
  "description": "Private VS Code coding-agent extension.",
  "version": "0.1.0",
  "publisher": "private",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:borger.agentView",
    "onCommand:borger.openAgent",
    "onCommand:borger.inspectWorkspace",
    "onCommand:borger.testModelConnection",
    "onCommand:borger.planTask",
    "onCommand:borger.generateProposedChanges",
    "onCommand:borger.fixDiagnostics",
    "onCommand:borger.fixLastFailedCommand",
    "onCommand:borger.fixCurrentFile",
    "onCommand:borger.explainLastError",
    "onCommand:borger.showPendingChanges",
    "onCommand:borger.clearPendingChanges",
    "onCommand:borger.applyApprovedChanges",
    "onCommand:borger.applyCurrentPendingChange",
    "onCommand:borger.revertLastApply",
    "onCommand:borger.runTerminalCommand",
    "onCommand:borger.runSuggestedCommand",
    "onCommand:borger.showCommandHistory",
    "onCommand:borger.clearCommandHistory",
    "onCommand:borger.manageProviders",
    "onCommand:borger.checkProviderBudgets",
    "onCommand:borger.switchProvider",
    "onCommand:borger.showProviderStatus",
    "onCommand:borger.resetProviderState",
    "onCommand:borger.showPermissions",
    "onCommand:borger.updatePermissionProfile"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "execa": "^9.3.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.2",
    "nanoid": "^5.0.7",
    "openai": "^4.56.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  },
  "contributes": {
    "configuration": {
      "title": "Borger",
      "properties": {
        "borger.litellmBaseUrl": {
          "type": "string",
          "default": "http://localhost:4000/v1",
          "description": "OpenAI-compatible LiteLLM base URL."
        },
        "borger.model": {
          "type": "string",
          "default": "qwen3-coder-next-abliterated-h200",
          "description": "Model alias used through LiteLLM."
        },
        "borger.mode": {
          "type": "string",
          "default": "plan",
          "enum": [
            "ask",
            "plan",
            "edit",
            "fix",
            "auto",
            "commit"
          ],
          "description": "Default Borger agent mode."
        },
        "borger.maxContextFiles": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "description": "Maximum files to include in workspace context scans."
        },
        "borger.maxFileSizeKb": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "Maximum file size Borger should read for context."
        },
        "borger.confirmBeforeApply": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before applying proposed changes."
        },
        "borger.confirmBeforeTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before running terminal commands."
        },
        "borger.permissionProfile": {
          "type": "string",
          "default": "edit_with_review",
          "enum": [
            "read_only",
            "plan_only",
            "edit_with_review",
            "trusted_workspace",
            "full_auto",
            "remote_ops"
          ],
          "description": "Default Borger permission profile when .borger/permissions.local.json is absent."
        },
        "borger.canReadWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canWriteWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canRunTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canUseGit": {
          "type": "boolean",
          "default": true,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canPushGitHub": {
          "type": "boolean",
          "default": false,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canUseSSH": {
          "type": "boolean",
          "default": false,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canDeploy": {
          "type": "boolean",
          "default": false,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canRunDestructiveCommands": {
          "type": "boolean",
          "default": false,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.requireConfirmationForDestructive": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before destructive actions."
        },
        "borger.requireConfirmationForGitPush": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before GitHub push actions."
        },
        "borger.requireConfirmationForSSH": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before SSH actions."
        },
        "borger.maxAutoFixLoops": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Maximum auto-fix loops for future auto modes."
        },
        "borger.providerRoutingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable budget-aware routing across authorized providers."
        },
        "borger.providerRoutingMode": {
          "type": "string",
          "default": "budget_aware",
          "enum": [
            "budget_aware"
          ],
          "description": "Provider routing mode."
        },
        "borger.defaultProviderId": {
          "type": "string",
          "default": "",
          "description": "Optional preferred provider ID for manual switching."
        },
        "borger.providerWarnPercent": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 100,
          "description": "Default provider budget warning threshold."
        },
        "borger.providerStopPercent": {
          "type": "number",
          "default": 95,
          "minimum": 0,
          "maximum": 100,
          "description": "Default provider budget stop threshold."
        },
        "borger.providerStopAction": {
          "type": "string",
          "default": "soft_stop",
          "enum": [
            "soft_stop",
            "hard_stop"
          ],
          "description": "Action to take when a provider reaches the stop threshold."
        },
        "borger.providerAutoSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch to another authorized provider when one is paused."
        },
        "borger.providerResetDay": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 28,
          "description": "Default monthly reset day for provider budgets."
        },
        "borger.providerMonthlyResetEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reset provider state when the monthly reset date passes."
        },
        "borger.providerLazyActivation": {
          "type": "boolean",
          "default": true,
          "description": "Do not warm or test providers automatically after monthly reset."
        },
        "borger.providerAutoWarmOnReset": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for future use. Keep false to avoid consuming Modal credit after reset."
        },
        "borger.providerLedgerEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Track local estimated provider usage in .borger/usage-ledger.jsonl."
        },
        "borger.modalH200PairHourlyCostUsd": {
          "type": "number",
          "default": 9.08,
          "minimum": 0,
          "description": "Estimated hourly cost for one Modal H200:2 provider."
        }
      }
    },
    "commands": [
      {
        "command": "borger.openAgent",
        "title": "Borger: Open Agent"
      },
      {
        "command": "borger.inspectWorkspace",
        "title": "Borger: Inspect Workspace"
      },
      {
        "command": "borger.testModelConnection",
        "title": "Borger: Test Model Connection"
      },
      {
        "command": "borger.planTask",
        "title": "Borger: Plan Task"
      },
      {
        "command": "borger.askAboutFile",
        "title": "Borger: Ask About Current File"
      },
      {
        "command": "borger.explainSelection",
        "title": "Borger: Explain Selection"
      },
      {
        "command": "borger.fixSelection",
        "title": "Borger: Fix Selection"
      },
      {
        "command": "borger.generateTests",
        "title": "Borger: Generate Tests"
      },
      {
        "command": "borger.refactorSelection",
        "title": "Borger: Refactor Selection"
      },
      {
        "command": "borger.runAgentTask",
        "title": "Borger: Run Agent Task"
      },
      {
        "command": "borger.generateProposedChanges",
        "title": "Borger: Generate Proposed Changes"
      },
      {
        "command": "borger.fixDiagnostics",
        "title": "Borger: Fix Diagnostics"
      },
      {
        "command": "borger.fixLastFailedCommand",
        "title": "Borger: Fix Last Failed Command"
      },
      {
        "command": "borger.fixCurrentFile",
        "title": "Borger: Fix Current File"
      },
      {
        "command": "borger.explainLastError",
        "title": "Borger: Explain Last Error"
      },
      {
        "command": "borger.showPendingChanges",
        "title": "Borger: Show Pending Changes"
      },
      {
        "command": "borger.clearPendingChanges",
        "title": "Borger: Clear Pending Changes"
      },
      {
        "command": "borger.applyApprovedChanges",
        "title": "Borger: Apply Approved Changes"
      },
      {
        "command": "borger.applyCurrentPendingChange",
        "title": "Borger: Apply Current Pending Change"
      },
      {
        "command": "borger.revertLastApply",
        "title": "Borger: Revert Last Apply"
      },
      {
        "command": "borger.runTerminalCommand",
        "title": "Borger: Run Terminal Command"
      },
      {
        "command": "borger.runSuggestedCommand",
        "title": "Borger: Run Suggested Command"
      },
      {
        "command": "borger.showCommandHistory",
        "title": "Borger: Show Command History"
      },
      {
        "command": "borger.clearCommandHistory",
        "title": "Borger: Clear Command History"
      },
      {
        "command": "borger.showPermissions",
        "title": "Borger: Show Permissions"
      },
      {
        "command": "borger.updatePermissionProfile",
        "title": "Borger: Update Permission Profile"
      },
      {
        "command": "borger.manageProviders",
        "title": "Borger: Manage Providers"
      },
      {
        "command": "borger.checkProviderBudgets",
        "title": "Borger: Check Provider Budgets"
      },
      {
        "command": "borger.switchProvider",
        "title": "Borger: Switch Provider"
      },
      {
        "command": "borger.showProviderStatus",
        "title": "Borger: Show Provider Status"
      },
      {
        "command": "borger.resetProviderState",
        "title": "Borger: Reset Provider State"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "borger",
          "title": "Borger",
          "icon": "media/borger-icon.svg"
        }
      ]
    },
    "views": {
      "borger": [
        {
          "id": "borger.agentView",
          "name": "Agent",
          "type": "webview"
        },
        {
          "id": "borger.tasksView",
          "name": "Tasks"
        },
        {
          "id": "borger.changesView",
          "name": "Changes"
        },
        {
          "id": "borger.memoryView",
          "name": "Memory"
        },
        {
          "id": "borger.settingsView",
          "name": "Settings"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "borger.askAboutFile",
          "when": "editorTextFocus",
          "group": "borger@1"
        },
        {
          "command": "borger.explainSelection",
          "when": "editorHasSelection",
          "group": "borger@2"
        },
        {
          "command": "borger.fixSelection",
          "when": "editorHasSelection",
          "group": "borger@3"
        },
        {
          "command": "borger.generateTests",
          "when": "editorHasSelection",
          "group": "borger@4"
        },
        {
          "command": "borger.refactorSelection",
          "when": "editorHasSelection",
          "group": "borger@5"
        }
      ]
    }
  }
}
