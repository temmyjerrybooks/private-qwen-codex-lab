    "viewsContainers": {
      "activitybar": [
        {
          "id": "borger",
          "title": "Borger",
          "icon": "media/borger-icon.svg"
        }
      ]
    },
    "views": {
      "borger": [
        {
          "id": "borger.agentView",
          "name": "Agent",
          "type": "webview"
        },
        {
          "id": "borger.tasksView",
          "name": "Tasks"
        },
        {
          "id": "borger.changesView",
          "name": "Changes"
        },
        {
          "id": "borger.memoryView",
          "name": "Memory"
        },
        {
          "id": "borger.settingsView",
          "name": "Settings"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "borger.askAboutFile",
          "when": "editorTextFocus",
          "group": "borger@1"
        },
        {
          "command": "borger.explainSelection",
          "when": "editorHasSelection",
          "group": "borger@2"
        },
        {
          "command": "borger.fixSelection",
          "when": "editorHasSelection",
          "group": "borger@3"
        },
        {
          "command": "borger.generateTests",
          "when": "editorHasSelection",
          "group": "borger@4"
        },
        {
          "command": "borger.refactorSelection",
          "when": "editorHasSelection",
          "group": "borger@5"
        }
      ]
    }
  }
}
