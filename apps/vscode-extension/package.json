{
  "name": "borger-vscode-agent",
  "displayName": "Borger",
  "description": "Private VS Code coding agent for repo-aware planning, safe edits, terminal verification, Git workflows, Remote Ops, and local project memory.",
  "version": "0.13.0",
  "publisher": "temmyjerrybooks",
  "private": true,
  "license": "UNLICENSED",
  "icon": "media/borger-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/temmyjerrybooks/private-qwen-codex-lab.git"
  },
  "homepage": "https://github.com/temmyjerrybooks/private-qwen-codex-lab#readme",
  "bugs": {
    "url": "https://github.com/temmyjerrybooks/private-qwen-codex-lab/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding-agent",
    "vscode",
    "litellm",
    "modal",
    "sglang",
    "qwen",
    "private-agent",
    "developer-tools"
  ],
  "activationEvents": [
    "onView:borger.agentView",
    "onView:borger.tasksView",
    "onView:borger.changesView",
    "onView:borger.memoryView",
    "onView:borger.settingsView",
    "onCommand:borger.openAgent",
    "onCommand:borger.inspectWorkspace",
    "onCommand:borger.testModelConnection",
    "onCommand:borger.planTask",
    "onCommand:borger.askAboutFile",
    "onCommand:borger.explainSelection",
    "onCommand:borger.fixSelection",
    "onCommand:borger.generateTests",
    "onCommand:borger.refactorSelection",
    "onCommand:borger.runAgentTask",
    "onCommand:borger.generateProposedChanges",
    "onCommand:borger.runAutoMode",
    "onCommand:borger.stopAutoMode",
    "onCommand:borger.showAutoModeStatus",
    "onCommand:borger.gitStatus",
    "onCommand:borger.createGitBranch",
    "onCommand:borger.stageGitChanges",
    "onCommand:borger.generateCommitMessage",
    "onCommand:borger.createGitCommit",
    "onCommand:borger.pushGitBranch",
    "onCommand:borger.preparePullRequest",
    "onCommand:borger.showRemoteHosts",
    "onCommand:borger.testSshConnection",
    "onCommand:borger.runRemoteCommand",
    "onCommand:borger.inspectRemoteProject",
    "onCommand:borger.showRemoteHistory",
    "onCommand:borger.showProjectMemory",
    "onCommand:borger.addProjectNote",
    "onCommand:borger.updateProjectSummary",
    "onCommand:borger.clearProjectMemory",
    "onCommand:borger.fixDiagnostics",
    "onCommand:borger.fixLastFailedCommand",
    "onCommand:borger.fixCurrentFile",
    "onCommand:borger.explainLastError",
    "onCommand:borger.showPendingChanges",
    "onCommand:borger.clearPendingChanges",
    "onCommand:borger.applyApprovedChanges",
    "onCommand:borger.applyCurrentPendingChange",
    "onCommand:borger.revertLastApply",
    "onCommand:borger.runTerminalCommand",
    "onCommand:borger.runSuggestedCommand",
    "onCommand:borger.showCommandHistory",
    "onCommand:borger.clearCommandHistory",
    "onCommand:borger.showPermissions",
    "onCommand:borger.updatePermissionProfile",
    "onCommand:borger.manageProviders",
    "onCommand:borger.checkProviderBudgets",
    "onCommand:borger.switchProvider",
    "onCommand:borger.showProviderStatus",
    "onCommand:borger.resetProviderState"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "package": "vsce package"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "execa": "^9.3.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.2",
    "nanoid": "^5.0.7",
    "openai": "^4.56.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  },
  "contributes": {
    "configuration": {
      "title": "Borger",
      "properties": {
        "borger.litellmBaseUrl": {
          "type": "string",
          "default": "http://localhost:4000/v1",
          "description": "OpenAI-compatible LiteLLM base URL."
        },
        "borger.model": {
          "type": "string",
          "default": "qwen3-coder-next-abliterated-h200",
          "description": "Model alias used through LiteLLM."
        },
        "borger.mode": {
          "type": "string",
          "default": "plan",
          "enum": [
            "ask",
            "plan",
            "edit",
            "fix",
            "auto",
            "commit"
          ],
          "description": "Default Borger agent mode."
        },
        "borger.maxContextFiles": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "description": "Maximum files to include in workspace context scans."
        },
        "borger.maxFileSizeKb": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "Maximum file size Borger should read for context."
        },
        "borger.confirmBeforeApply": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before applying proposed changes."
        },
        "borger.confirmBeforeTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before running terminal commands."
        },
        "borger.autoModeEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable controlled local Auto Mode. Environment override: BORGER_AUTO_MODE_ENABLED."
        },
        "borger.autoMaxLoops": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Maximum loops for controlled Auto Mode. Environment override: BORGER_AUTO_MAX_LOOPS."
        },
        "borger.autoRequireApprovalForEdits": {
          "type": "boolean",
          "default": true,
          "description": "Require approved pending diffs before Auto Mode applies edits. Environment override: BORGER_AUTO_REQUIRE_APPROVAL_FOR_EDITS."
        },
        "borger.autoRequireApprovalForCommands": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before Auto Mode runs verification commands. Environment override: BORGER_AUTO_REQUIRE_APPROVAL_FOR_COMMANDS."
        },
        "borger.autoAllowedVerificationCommands": {
          "type": "array",
          "default": [
            "npm.cmd run check-types",
            "npm.cmd run compile",
            "npm test",
            "npm run lint",
            "pnpm test",
            "python -m py_compile"
          ],
          "items": {
            "type": "string"
          },
          "description": "Exact verification commands Auto Mode may run. Environment override: BORGER_AUTO_ALLOWED_VERIFICATION_COMMANDS."
        },
        "borger.autoStopOnDestructiveCommand": {
          "type": "boolean",
          "default": true,
          "description": "Stop Auto Mode before running destructive-looking commands. Environment override: BORGER_AUTO_STOP_ON_DESTRUCTIVE_COMMAND."
        },
        "borger.autoStopOnSecretFile": {
          "type": "boolean",
          "default": true,
          "description": "Stop Auto Mode if a proposed change targets a secret-like file. Environment override: BORGER_AUTO_STOP_ON_SECRET_FILE."
        },
        "borger.permissionProfile": {
          "type": "string",
          "default": "edit_with_review",
          "enum": [
            "read_only",
            "plan_only",
            "edit_with_review",
            "trusted_workspace",
            "full_auto",
            "remote_ops"
          ],
          "description": "Default Borger permission profile when .borger/permissions.local.json is absent."
        },
        "borger.canReadWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canWriteWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canRunTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canUseGit": {
          "type": "boolean",
          "default": true,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canPushGitHub": {
          "type": "boolean",
          "default": false,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canUseSSH": {
          "type": "boolean",
          "default": false,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canDeploy": {
          "type": "boolean",
          "default": false,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.canRunDestructiveCommands": {
          "type": "boolean",
          "default": false,
          "description": "Default capability flag documented for local permission profiles."
        },
        "borger.requireConfirmationForDestructive": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before destructive actions."
        },
        "borger.requireConfirmationForGitPush": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before GitHub push actions."
        },
        "borger.requireConfirmationForSSH": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before SSH actions."
        },
        "borger.maxAutoFixLoops": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Maximum auto-fix loops for future auto modes."
        },
        "borger.providerRoutingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable budget-aware routing across authorized providers."
        },
        "borger.providerRoutingMode": {
          "type": "string",
          "default": "budget_aware",
          "enum": [
            "budget_aware"
          ],
          "description": "Provider routing mode."
        },
        "borger.defaultProviderId": {
          "type": "string",
          "default": "",
          "description": "Optional preferred provider ID for manual switching."
        },
        "borger.providerWarnPercent": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 100,
          "description": "Default provider budget warning threshold."
        },
        "borger.providerStopPercent": {
          "type": "number",
          "default": 95,
          "minimum": 0,
          "maximum": 100,
          "description": "Default provider budget stop threshold."
        },
        "borger.providerStopAction": {
          "type": "string",
          "default": "soft_stop",
          "enum": [
            "soft_stop",
            "hard_stop"
          ],
          "description": "Action to take when a provider reaches the stop threshold."
        },
        "borger.providerAutoSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically switch to another authorized provider when one is paused."
        },
        "borger.providerResetDay": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 28,
          "description": "Default monthly reset day for provider budgets."
        },
        "borger.providerMonthlyResetEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reset provider state when the monthly reset date passes."
        },
        "borger.providerLazyActivation": {
          "type": "boolean",
          "default": true,
          "description": "Do not warm or test providers automatically after monthly reset."
        },
        "borger.providerAutoWarmOnReset": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for future use. Keep false to avoid consuming Modal credit after reset."
        },
        "borger.providerLedgerEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Track local estimated provider usage in .borger/usage-ledger.jsonl."
        },
        "borger.modalH200PairHourlyCostUsd": {
          "type": "number",
          "default": 9.08,
          "minimum": 0,
          "description": "Estimated hourly cost for one Modal H200:2 provider."
        }
      }
    },
    "commands": [
      {
